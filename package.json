{
  "name": "phone-fns",
  "version": "4.1.2",
  "description": "A small, modern, and functional phone library for javascript",
  "main": "dist/phone-fns.min.cjs",
  "module": "src/index.js",
  "types": "dist/phone-fns.d.ts",
  "type": "module",
  "unpkg": "dist/phone-fns.iife.min.js",
  "jsdelivr": "dist/phone-fns.iife.min.js",
  "scripts": {
    "prepack": "npm run scripts && npm run lint && npm test && npm run build && npm run docs",
    "scripts": "node scripts/create-export.js",
    "docs": "jsdoc -c jsdoc.json",
    "build": "npm run build:types && rollup -c",
    "lint": "eslint",
    "test": "node --test \"tests/*.spec.js\"",
    "test:cov": "c8 node --test \"tests/*.spec.js\"",
    "coverage": "c8 check-coverage --lines 90 --branches 90 --functions 90 --statements 90",
    "report": "c8 report --reporter=text-lcov > coverage.lcov",
    "build:types": "node node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/phone-fns.d.cts",
        "default": "./dist/phone-fns.min.cjs"
      },
      "import": {
        "types": "./dist/phone-fns.d.ts",
        "default": "./dist/phone-fns.min.js"
      },
      "default": {
        "types": "./dist/phone-fns.d.ts",
        "default": "./dist/phone-fns.min.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhershman1/phone-fns"
  },
  "bugs": {
    "url": "https://github.com/dhershman1/phone-fns/issues"
  },
  "homepage": "https://phone-fns.dusty.codes/",
  "keywords": [
    "format",
    "phone number",
    "functional",
    "phone libary",
    "phone",
    "phone-fns",
    "telephone",
    "tel",
    "functional library",
    "formatting",
    "modern"
  ],
  "author": "Dustin Hershman <dustinh17@gmail.com>",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.2",
    "@typescript/typescript6": "6.0.2",
    "c8": "^12.0.0",
    "eslint": "10.15.0",
    "jsdoc": "4.0.5",
    "neostandard": "0.14.1",
    "pinet": "1.2.1",
    "rollup": "4.68.5",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
